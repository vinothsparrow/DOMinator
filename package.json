{
  "name": "dominator",
  "version": "1.0.0",
  "description": "Chrome extension designed to assist developers and security professionals in testing and identifying DOM-based Cross-Site Scripting (XSS) vulnerabilities on websites.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinothsparrow/DOMinator.git"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && cross-env __FIREFOX__=true vite build",
    "build:watch": "cross-env __DEV__=true vite build -w --mode development",
    "build:firefox:watch": "cross-env __DEV__=true __FIREFOX__=true vite build -w --mode development",
    "build:hmr": "rollup --config utils/reload/rollup.config.mjs",
    "wss": "node utils/reload/initReloadServer.js",
    "dev": "yarn build:hmr && (run-p wss build:watch)",
    "dev:firefox": "yarn build:hmr && (run-p wss build:firefox:watch)",
    "test": "vitest",
    "test:run": "vitest run",
    "package": "npm run build && node utils/package.js chrome",
    "package:firefox": "npm run build:firefox && node utils/package.js firefox",
    "pages": "node utils/build-pages.js",
    "screenshots": "node utils/screenshots/capture.js",
    "commitlint": "commitlint --edit",
    "lint": "eslint src",
    "prettier": "prettier . --write"
  },
  "type": "module",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "construct-style-sheets-polyfill": "^3.1.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.4",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-sucrase": "^5.1.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "0.3.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.6.1",
    "chokidar": "5.0.0",
    "cross-env": "10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fs-extra": "11.4.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "lint-staged": "17.5.1",
    "magic-string": "^1.4.1",
    "marked": "^18.0.13",
    "npm-run-all": "4.1.5",
    "postcss": "^8.5.28",
    "prettier": "3.9.7",
    "rollup": "4.63.3",
    "sass": "1.104.1",
    "tailwindcss": "^4.3.3",
    "ts-loader": "9.6.2",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "^5.0.1",
    "ws": "8.21.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
